# Copy to .env.local and fill in. Never commit .env.local.

# --- required ---------------------------------------------------------------

# MongoDB Atlas connection string. The database name is part of the path.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/shani-travels?appName=ShaniTravels"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public origin. Also the base for canonical tags, Open Graph URLs, the
# sitemap and the JSON-LD business record — set it to the real domain in
# production or those all point at localhost.
NEXTAUTH_URL="http://localhost:3000"

# --- media ------------------------------------------------------------------

# Cloudinary, for vehicle photography uploaded through the admin panel.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- optional ---------------------------------------------------------------

# Visitor analytics. Set either one to switch it on; leave both blank and no
# tracking script is served at all. Read at runtime, so no rebuild is needed.
# Conversion counts in Admin -> Analytics are first-party and work regardless.
PLAUSIBLE_DOMAIN=""
GA_MEASUREMENT_ID=""

# Lead notification email. SMTP takes priority when both are configured.
# Gmail needs an App Password, not the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
# Where new booking and enquiry notifications are sent.
OPS_EMAIL=""

# Lets scripts purge the Next cache: POST /api/revalidate?tag=vehicles&secret=…
# Without it, only a signed-in admin can call that endpoint.
REVALIDATE_SECRET=""

# Overrides Node's DNS resolvers. Only needed on hosts where the bundled
# c-ares resolver cannot read the OS config and mongodb+srv lookups fail.
# See lib/dns-fallback.ts. Setting it also silences that warning.
DNS_SERVERS=""

# Extra origins allowed to reach `next dev` through a tunnel (ngrok etc).
DEV_TUNNEL_HOST=""
